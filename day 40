/*
Write a program to find the 1's complement
of a binary number and print it.
*/

#include <stdio.h>

int main(void)
{
    long long binary;
    long long temp;
    long long divisor = 1;

    printf("Enter a binary number: ");
    scanf("%lld", &binary);

    temp = binary;

    while (temp >= 10)
    {
        divisor = divisor * 10;
        temp = temp / 10;
    }

    printf("1's complement = ");

    while (divisor > 0)
    {
        int digit = (binary / divisor) % 10;

        if (digit == 0)
        {
            printf("1");
        }
        else if (digit == 1)
        {
            printf("0");
        }
        else
        {
            printf("\nInvalid binary number\n");
            return 0;
        }

        divisor = divisor / 10;
    }

    printf("\n");

    return 0;
}
