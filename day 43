/*
Write a program to check if a number is a strong number.
*/

#include <stdio.h>

int main(void)
{
    int number, original;
    int digit, i;
    int factorial;
    int sum = 0;

    printf("Enter a number: ");
    scanf("%d", &number);

    original = number;

    while (number != 0)
    {
        digit = number % 10;

        factorial = 1;

        for (i = 1; i <= digit; i++)
        {
            factorial = factorial * i;
        }

        sum = sum + factorial;

        number = number / 10;
    }

    if (sum == original)
    {
        printf("Strong number\n");
    }
    else
    {
        printf("Not strong number\n");
    }

    return 0;
}