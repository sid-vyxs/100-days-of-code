#include <stdio.h>

int main(void)
{
    int i, j;

    for (i = 1; i <= 5; i = i + 2)
    {
        for (j = 1; j <= i; j++)
        {
            printf("*\n");
        }

        printf("\n");
    }

    for (i = 3; i >= 1; i = i - 2)
    {
        for (j = 1; j <= i; j++)
        {
            printf("*\n");
        }

        if (i != 1)
        {
            printf("\n");
        }
    }

    return 0;
}
