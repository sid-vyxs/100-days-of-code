/*
Write a program to print all factors of a given number.
*/

#include <stdio.h>

int main(void)
{
    int number, i;

    printf("Enter a number: ");
    scanf("%d", &number);

    printf("Factors: ");

    for (i = 1; i <= number; i++)
    {
        if (number % i == 0)
        {
            printf("%d ", i);
        }
    }

    printf("\n");

    return 0;
}
