/*
Write a program to take a number as input
and print its equivalent binary representation.
*/

#include <stdio.h>

int main(void)
{
    int number, remainder;
    long long binary = 0;
    long long place = 1;

    printf("Enter a decimal number: ");
    scanf("%d", &number);

    if (number == 0)
    {
        printf("Binary = 0\n");
        return 0;
    }

    while (number > 0)
    {
        remainder = number % 2;

        binary = binary + remainder * place;

        place = place * 10;

        number = number / 2;
    }

    printf("Binary = %lld\n", binary);

    return 0;
}
